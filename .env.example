# Keys are read ONLY by the Electron main process. Never import in renderer/phone code.
# Copy to .env (gitignored) and fill in. Windows user env vars also work.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# Kill switches. Unset = off at startup; turn on per session from the overlay ("AI off" pill).
# NEBIUS_LIVE_CALLS_ENABLED=false
# GEMINI_LIVE_CALLS_ENABLED=false

# Route model overrides (empty = use config.json llm.routes). Exact, case-sensitive IDs.
NEBIUS_UTILITY_MODEL=
NEBIUS_DEFAULT_MODEL=
NEBIUS_DEEP_MODEL=
NEBIUS_PERSONAL_MODEL=
GEMINI_FALLBACK_MODEL=
DEEPGRAM_STT_MODEL=flux-general-en

# Budget (USD). Defaults live in config.json "budget"; these document the $40 mode.
# NEBIUS_TOTAL_BUDGET_USD=40.00
# NEBIUS_PROTECTED_RESERVE_USD=8.00
# NEBIUS_HARD_STOP_USD=32.00
# NEBIUS_COST_SAFETY_MULTIPLIER=1.20

# Optional Vkin cloud sync (Supabase project URL + anon/publishable key; never the service_role key)
VKIN_SUPABASE_URL=
VKIN_SUPABASE_ANON_KEY=
