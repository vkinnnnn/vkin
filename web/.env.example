# Copy to .env.local (gitignored) and fill in from your Supabase project settings.
# Only the project URL and the public anon key belong here. Never put a service_role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hosted Vkin API base URL (no trailing slash). Empty hides the trial minutes card on the dashboard.
VITE_VKIN_API_URL=
# Set to 1 to show "Continue with Google" on the sign-in page (enable the Google provider in Supabase first).
VITE_GOOGLE_ENABLED=
# Public link to the Windows installer. Empty keeps the "nothing to download yet" text on the landing page.
VITE_DOWNLOAD_URL=
